rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || 
             !('uid' in resource.data) || 
             request.resource.data.uid == resource.data.uid || 
             isAdmin();
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isEmailAdmin() {
      return isAuthenticated() && 
             request.auth.token != null &&
             'email' in request.auth.token &&
             request.auth.token.email != null &&
             request.auth.token.email is string &&
             (
               request.auth.token.email.lower() == "clashfouche@gmail.com" ||
               request.auth.token.email.lower() == "teamotakuempire@gmail.com" ||
               request.auth.token.email.lower() == "theaveriansupport@gmail.com" ||
               request.auth.token.email.lower() == "hencofouche8@gmail.com"
             );
    }

    function isDocAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isEmailAdmin() || isDocAdmin();
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number || data[field] is int || data[field] is float;
    }

    function isOptionalList(data, field) {
      return !(field in data) || data[field] == null || data[field] is list;
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function isOptionalDate(data, field) {
      return !(field in data) || data[field] == null || data[field] is string;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidBird(data) {
      return hasRequiredFields(['name', 'species', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.species is string && data.species.size() > 0 && data.species.size() < 200 &&
             data.uid is string &&
             isOptionalString(data, 'subSpecies', 200) &&
             isOptionalString(data, 'sex', 50) &&
             isOptionalDate(data, 'birthDate') &&
             isOptionalDate(data, 'purchaseDate') &&
             isOptionalString(data, 'ageYear', 100) &&
             isOptionalString(data, 'cageId', 200) &&
             isOptionalString(data, 'motherId', 200) &&
             isOptionalString(data, 'fatherId', 200) &&
             isOptionalString(data, 'mateId', 200) &&
             isOptionalString(data, 'boughtFromId', 200) &&
             isOptionalString(data, 'ringNumber', 100) &&
             isOptionalString(data, 'bandingStatus', 100) &&
             isOptionalString(data, 'sexingMethod', 100) &&
             isOptionalString(data, 'deliveryOptions', 200) &&
             isOptionalString(data, 'vetNotes', 2000) &&
             isOptionalBool(data, 'vetChecked') &&
             isOptionalBool(data, 'isGhost') &&
             isOptionalString(data, 'ghostId', 200) &&
             isOptionalList(data, 'offspringIds') &&
             isOptionalList(data, 'mutations') &&
             isOptionalList(data, 'splitMutations') &&
             isOptionalList(data, 'statuses') &&
             isOptionalList(data, 'imageUrls') &&
             isOptionalList(data, 'documents') &&
             isOptionalString(data, 'imageUrl', 2000000) &&
             isOptionalString(data, 'notes', 5000) &&
             isOptionalNumber(data, 'purchasePrice') &&
             isOptionalNumber(data, 'estimatedValue') &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidTransaction(data) {
      return hasRequiredFields(['type', 'category', 'amount', 'date', 'uid']) &&
             data.type in ['Income', 'Expense'] &&
             data.category is string && data.category.size() > 0 && data.category.size() < 200 &&
             isOptionalNumber(data, 'amount') &&
             isOptionalDate(data, 'date') &&
             data.uid is string &&
             isOptionalString(data, 'birdId', 200) &&
             isOptionalString(data, 'pairId', 200) &&
             isOptionalString(data, 'contactId', 200) &&
             isOptionalString(data, 'description', 5000) &&
             isOptionalString(data, 'recurring', 50) &&
             isOptionalDate(data, 'nextDueDate') &&
             isOptionalString(data, 'recurringParentId', 200) &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidCage(data) {
      return hasRequiredFields(['name', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.uid is string &&
             isOptionalString(data, 'location', 500) &&
             isOptionalString(data, 'type', 100) &&
             isOptionalString(data, 'notes', 5000) &&
             isOptionalString(data, 'imageUrl', 2000000) &&
             isOptionalList(data, 'imageUrls') &&
             isOptionalNumber(data, 'width') &&
             isOptionalNumber(data, 'height') &&
             isOptionalNumber(data, 'depth') &&
             isOptionalString(data, 'dimensionUnit', 50) &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidPair(data) {
      return hasRequiredFields(['maleId', 'femaleId', 'status', 'uid']) &&
             data.maleId is string && data.femaleId is string &&
             data.status is string &&
             data.uid is string &&
             isOptionalString(data, 'cageId', 200) &&
             isOptionalDate(data, 'startDate') &&
             isOptionalDate(data, 'endDate') &&
             isOptionalList(data, 'imageUrls') &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidBreedingRecord(data) {
      return hasRequiredFields(['pairId', 'startDate', 'uid']) &&
             data.pairId is string && data.pairId.size() > 0 && data.pairId.size() < 200 &&
             data.uid is string &&
             isOptionalDate(data, 'startDate') &&
             isOptionalDate(data, 'endDate') &&
             isOptionalNumber(data, 'eggsLaid') &&
             isOptionalNumber(data, 'eggsHatched') &&
             isOptionalNumber(data, 'chicksWeaned') &&
             isOptionalNumber(data, 'incubationDays') &&
             isOptionalNumber(data, 'ringingDays') &&
             isOptionalList(data, 'eggs') &&
             isOptionalList(data, 'offspringIds') &&
             isOptionalString(data, 'notes', 5000) &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidTask(data) {
      return hasRequiredFields(['title', 'status', 'uid']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 300 &&
             data.status is string &&
             data.uid is string &&
             isOptionalString(data, 'description', 5000) &&
             isOptionalString(data, 'priority', 50) &&
             isOptionalString(data, 'category', 100) &&
             isOptionalDate(data, 'dueDate') &&
             isOptionalDate(data, 'reminderDate') &&
             isOptionalNumber(data, 'reminderLeadTime') &&
             isOptionalList(data, 'birdIds') &&
             isOptionalList(data, 'subTasks') &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidContact(data) {
      return hasRequiredFields(['name', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.uid is string &&
             isOptionalString(data, 'type', 50) &&
             isOptionalString(data, 'phone', 100) &&
             isOptionalString(data, 'email', 200) &&
             isOptionalString(data, 'address', 500) &&
             isOptionalString(data, 'notes', 5000) &&
             isOptionalDate(data, 'createdAt') &&
             isOptionalDate(data, 'updatedAt');
    }

    function isValidSharedItem(data) {
      return hasRequiredFields(['type', 'action', 'data', 'createdAt', 'createdBy']) &&
             data.type in ['bird', 'pair', 'cage'] &&
             data.action in ['share', 'transfer'] &&
             data.data is string && data.data.size() < 2000000 &&
             data.createdAt is string &&
             data.createdBy is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /contacts/{contactId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidContact(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidContact(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /birds/{birdId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidBird(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidBird(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /cages/{cageId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidCage(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidCage(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /pairs/{pairId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidPair(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidPair(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /breedingRecords/{recordId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidBreedingRecord(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidBreedingRecord(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /tasks/{taskId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidTask(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidTask(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /transactions/{transactionId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin()) && (isValidTransaction(request.resource.data) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && (request.resource.data.uid == resource.data.uid || !('uid' in request.resource.data) || isAdmin()) && (isValidTransaction(request.resource.data) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /userSettings/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /push_subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /shared_items/{itemId} {
      allow read: if true; // Anyone with the link can read
      allow create: if isAuthenticated() && ((isValidSharedItem(request.resource.data) && request.resource.data.createdBy == request.auth.uid) || isAdmin());
      allow update: if isAuthenticated() && ((resource.data.createdBy == request.auth.uid && isValidSharedItem(request.resource.data)) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sellerProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /marketplaceListings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /marketplaceReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.buyerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
    }

    match /wikiSpecies/{speciesId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /wikiMutations/{mutationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Global Admin Catch-All: Guaranteed full read & write access across all collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
